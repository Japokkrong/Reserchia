# Copy to .env and fill in. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional — defaults shown.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# enabled | disabled. DeepSeek V4 reasons by default, so this is sent
# explicitly either way. Defaults off: a date lookup needs no reasoning, and
# thinking costs latency and tokens. Turning it on is safe here — see the
# reasoning_details note in README.md.
OPENROUTER_REASONING=disabled

# minimal | low | medium | high | xhigh | max. Only sent when reasoning is on.
OPENROUTER_REASONING_EFFORT=low

# 0 keeps tool routing deterministic.
OPENROUTER_TEMPERATURE=0

# Optional attribution — makes your app appear on OpenRouter's leaderboards.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# --- paper library -----------------------------------------------------------
# Encoder for stored papers. 1024-dim, 8192-token context, ~$0.01/M tokens.
# Changing this invalidates the library: existing vectors are from another model.
OPENROUTER_EMBED_MODEL=baai/bge-m3

# Where the library lives. Defaults to ~/.local/share/reserchia — a personal
# collection that accumulates across projects, not a per-directory one.
RESERCHIA_STORE_DIR=

# Dense/lexical mix for library search. 0 is pure BM25, 1 is pure embeddings.
# 0.5 measured best on Recall@1/@5/@10 and MRR together; the top is flat from
# 0.4 to 0.6, and both extremes are clearly worse. See rag-eda/REPORT.md.
RESERCHIA_RAG_ALPHA=0.5

# --- observability -----------------------------------------------------------
# Step timings and usage are always written locally to <store_dir>/logs/*.jsonl.
# Nothing leaves the machine for that; `/stats` and scripts/log_report.py read it.
RESERCHIA_LOGGING=true
RESERCHIA_LOG_DIR=

# LangSmith tracing is optional and OFF unless you set these. Turning it on
# sends prompts, retrieved passages and answers to LangSmith's servers.
# A dead key is harmless: the agent runs normally and its uploader is silenced.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=reserchia

# --- docker stack ---------------------------------------------------------------
# Only used by `docker compose`. Leave them unset to run on the host as before:
# with no DATABASE_URL the app skips auth and the data layer entirely, and
# conversations stay in memory.
#
# Generate the secrets once:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_USER=reserchia
POSTGRES_DB=reserchia
POSTGRES_PASSWORD=

# RustFS ships with the well-known rustfsadmin/rustfsadmin default. Replace it.
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=reserchia

# RustFS's built-in object browser, at
#   http://localhost:19001/rustfs/console/
# -- sign in with the access/secret key above. Note the path: the root of that
# port is still the S3 handler and answers 403.
#
# Off by default; it is beta software, so it is worth switching on when you
# want to look inside the bucket and off again after. Apply a change with
# `docker compose up -d rustfs`.
RUSTFS_CONSOLE_ENABLE=false

# Chainlit refuses to start with auth enabled and no secret.
CHAINLIT_AUTH_SECRET=

# Set by compose. Two endpoints, and they are not interchangeable: the app
# uploads over the compose network, while the browser fetches presigned URLs
# over the published port. Signing reads against the internal name gives the
# page ERR_NAME_NOT_RESOLVED while uploads look fine.
# DATABASE_URL=postgresql+asyncpg://reserchia:PASSWORD@localhost:5432/reserchia
# RUSTFS_ENDPOINT=http://rustfs:9000
# RUSTFS_PUBLIC_ENDPOINT=http://localhost:19000
